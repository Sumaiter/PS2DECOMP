{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PS2DECOMP game project",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "version",
    "coordination"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "string",
      "default": "generic",
      "pattern": "^(generic|[A-Za-z][A-Za-z0-9_]*_(PAL|NTSC_U|NTSC_J))$"
    },
    "mainProgram": {
      "type": "string"
    },
    "programs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "elf",
          "sha256"
        ],
        "properties": {
          "elf": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "gp": {
            "type": [
              "string",
              "integer"
            ]
          },
          "gpEvidence": {
            "type": "string",
            "minLength": 1
          },
          "symbols": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "integer"
              ]
            }
          }
        },
        "dependencies": {
          "gp": [
            "gpEvidence"
          ]
        }
      }
    },
    "functions": {
      "type": "string"
    },
    "compileCommand": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{64}$"
      }
    },
    "sourceFlags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coordination": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "local",
            "command",
            "native"
          ]
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "workflow": {
          "enum": [
            "public-first",
            "local-first"
          ],
          "default": "public-first",
          "description": "Native adapter workflow, when supported: local-first allows explicitly authorized local matching before claiming selected PR source scopes publicly. Fresh foreign reservations still block work. Adapters retain their own coordination policy."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "adapter": {
            "const": "generic"
          }
        }
      },
      "then": {
        "required": [
          "programs",
          "functions",
          "compileCommand",
          "inputs"
        ]
      }
    }
  ]
}
